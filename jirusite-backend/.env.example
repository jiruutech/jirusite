# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/jirusite_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_SECRET=your-otp-hmac-secret
OTP_STEP=300

# Server
PORT=3000
NODE_ENV=development

# File Storage (S3-compatible)
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=jirusite-receipts
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Firebase Admin (for FCM push notifications)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# SMS Gateway (AfroMessage / Geez SMS)
SMS_API_URL=https://api.afromessage.com/api/send
SMS_API_TOKEN=your-sms-api-token
SMS_SENDER_ID=JIRUSite

# Telebirr
TELEBIRR_APP_ID=your-telebirr-app-id
TELEBIRR_APP_KEY=your-telebirr-app-key
TELEBIRR_SHORT_CODE=your-short-code
TELEBIRR_NOTIFY_URL=https://your-domain.com/api/billing/telebirr/webhook

# CORS
ALLOWED_ORIGINS=http://localhost:3001,https://app.jirusite.com
